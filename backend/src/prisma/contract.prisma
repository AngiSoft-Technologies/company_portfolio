    client            Client?             @relation(fields: [clientId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "Opportunity_clientId_fkey")
    booking           Booking?            @relation(fields: [bookingId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "Opportunity_bookingId_fkey")
