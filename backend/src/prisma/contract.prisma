namespace public {
  model AboutSection {
    id        String       @id(map: "AboutSection_pkey")
    key       String
    title     String
    sortOrder Int          @default(0)
    enabled   Boolean      @default(true)
    content   Jsonb?
    createdAt TimestampString(3) @default(now())
    updatedAt TimestampString(3)

    @@index([enabled], map: "AboutSection_enabled_idx")
    @@index([key], map: "AboutSection_key_key", unique: true)
    @@index([sortOrder], map: "AboutSection_sortOrder_idx")
  @@map("AboutSection")
}

  model Agent {
    id              String               @id(map: "Agent_pkey")
    key             String
    name            String
    role            String
    department      String?
    kind            String
    description     String?
    status          String               @default("active")
    scheduleMinutes Int                  @default(1440)
    config          Jsonb?
    lastRunAt       TimestampString(3)?
    nextRunAt       TimestampString(3)?
    createdAt       TimestampString(3)   @default(now())
    updatedAt       TimestampString(3)

    @@index([key], map: "Agent_key_key", unique: true)
    @@index([status, nextRunAt], map: "Agent_status_nextRunAt_idx")
  @@map("Agent")
}

  model AgentRun {
    id          String               @id(map: "AgentRun_pkey")
    agentId     String
    agentKey    String
    _trigger    String               @default("schedule") @map("trigger")
    status      String               @default("running")
    summary     String?
    output      Jsonb?
    error       String?
    startedAt   TimestampString(3)   @default(now())
    finishedAt  TimestampString(3)?
    createdById String?

    @@index([agentId, startedAt], map: "AgentRun_agentId_startedAt_idx")
    @@index([agentKey, startedAt], map: "AgentRun_agentKey_startedAt_idx")
    @@index([status], map: "AgentRun_status_idx")
  @@map("AgentRun")
}

