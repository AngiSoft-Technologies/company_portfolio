namespace public {
  model AboutSection {
    id        String       @id(map: "AboutSection_pkey")
    key       String
    title     String
    sortOrder Int          @default(0)
    enabled   Boolean      @default(true)
    content   Jsonb?
    createdAt TimestampString(3) @default(now())
    updatedAt TimestampString(3)

    @@index([enabled], map: "AboutSection_enabled_idx")
    @@index([key], map: "AboutSection_key_key", unique: true)
    @@index([sortOrder], map: "AboutSection_sortOrder_idx")
  @@map("AboutSection")
}

  model AnalyticsEvent {
