{
  "name": "angisoft-platform",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter angisoft-web dev",
    "dev:admin": "pnpm --filter angisoft-admin dev",
    "dev:backend": "pnpm --filter angisoft-backend dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "perf:budget": "node scripts/check-bundle-budget.mjs all",
    "perf:lighthouse": "node scripts/lighthouse-budget.mjs",
    "test:e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@playwright/test": "^1.65.1",
    "chrome-launcher": "^1.2.2",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "lighthouse": "^13.6.0",
    "turbo": "^2.5.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.35.0",
    "vite-imagetools": "^10.0.1"
  }
}
